# ====================================================================
# Les Brunos — Variables d'environnement (modèle)
# Copier vers .env.local pour le dev :  cp .env.example .env.local
# Ne JAMAIS committer .env.local (déjà ignoré par .gitignore).
# ====================================================================

# --- Supabase : public (exposé au navigateur, sans danger) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Clé "anon" / publishable (sb_publishable_...). Protégée par les RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase : SERVEUR UNIQUEMENT (jamais exposé au client) ---
# Clé service_role : contourne les RLS. Réservée aux Server Actions/Route Handlers admin.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Application ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
